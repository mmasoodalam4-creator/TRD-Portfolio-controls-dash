{
  "name": "tazayud-owner-pmo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Tazayud Owner PMO \u2014 Integrated Portfolio & Project Controls System.",
  "scripts": {
    "api": "tsx server/server.ts",
    "api:dev": "tsx watch server/server.ts",
    "baseline": "node scripts/freeze-baseline.mjs",
    "brand": "node scripts/brand-crop.mjs",
    "build": "tsc --noEmit && vite build",
    "check:actions": "node scripts/check-actions.mjs",
    "check:api": "tsx scripts/check-api.mjs",
    "check:api-origin": "tsx scripts/check-api-origin.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:esm": "node scripts/check-serverless-esm.mjs",
    "check:data": "node scripts/check-data-parity.mjs",
    "check:domain": "node scripts/check-domain-rules.mjs",
    "check:duties": "node scripts/check-duties.mjs",
    "check:e2e": "tsx scripts/e2e-hgw.mjs",
    "check:forecast": "node scripts/check-forecast.mjs",
    "check:integrity": "node scripts/check-integrity.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:platform": "tsx scripts/check-platform.mjs",
    "check:qa": "tsx scripts/check-qa.mjs",
    "check:coherence": "node scripts/check-coherence.mjs",
    "check:newdev": "node scripts/check-newdev.mjs",
    "check:recon": "node scripts/check-reconciliation.mjs",
    "check:scope": "node scripts/check-scope.mjs",
    "check:workflow": "tsx scripts/check-workflow.mjs",
    "check:uat": "tsx scripts/check-uat.mjs",
    "db:reset": "tsx db/seed.ts --reset",
    "db:seed": "tsx db/seed.ts",
    "db:user": "tsx db/user.ts",
    "db:users": "tsx db/seed-users.ts",
    "dev": "vite",
    "lint": "eslint src scripts api server db",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "verify": "npm run lint && npm run typecheck:server && npm run build && node scripts/check-bundle.mjs && node scripts/check-serverless-esm.mjs && tsx scripts/check-api-origin.mjs && node scripts/verify.mjs && node scripts/visual-diff.mjs && node scripts/diff-overlays.mjs && node scripts/check-scope.mjs && node scripts/check-layout.mjs && node scripts/check-actions.mjs && node scripts/check-domain-rules.mjs && node scripts/check-data-parity.mjs && node scripts/check-reconciliation.mjs && node scripts/check-coherence.mjs && node scripts/check-newdev.mjs && node scripts/check-forecast.mjs && node scripts/check-integrity.mjs && npm run check:charts",
    "verify:visual": "node scripts/visual-diff.mjs && node scripts/diff-overlays.mjs",
    "docs": "python3 scripts/md-to-docx.py docs/USER_MANUAL.md docs/USER_MANUAL.docx \"Tazayud Owner PMO \u2014 User Manual\" && python3 scripts/md-to-docx.py docs/LAUNCH_READINESS.md docs/LAUNCH_READINESS.docx \"Tazayud Owner PMO \u2014 Launch Readiness Report\"",
    "check:charts": "tsx scripts/check-charts.mjs"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.12.0",
    "pixelmatch": "^6.0.0",
    "playwright": "1.56.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.1.0"
  },
  "license": "UNLICENSED"
