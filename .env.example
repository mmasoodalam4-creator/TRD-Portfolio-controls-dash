# ==========================================================================
# Tazayud Owner PMO — environment
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way:
# it holds a database URL and the token signing secret.
#
#   cp .env.example .env
#
# NOTHING HERE IS NEEDED FOR THE OFFLINE DELIVERABLE. `npm run build` with
# no environment at all produces the portable dist/index.html on the
# fixtures, which is the intended behaviour, not a misconfiguration.
# Setting VITE_API_URL is what turns a deployment into the platform.
# ==========================================================================


# ---- the app -------------------------------------------------------------

# The API origin the browser talks to. Read at BUILD time by Vite, so
# changing it means rebuilding, not restarting.
#
#   unset  -> MockRepository. The self-contained pitch demo: no sign-in,
#             no network requests, opens with a double-click.
#   set    -> HttpRepository. The platform: sign-in required, data from
#             Postgres. Must be served over HTTP — a file:// page has an
#             opaque origin and the browser blocks its API requests.
#
# USE "/" WHEN THE APP AND THE API ARE ONE DEPLOYMENT. On Vercel they are:
# the SPA and api/[...path].ts are the same project on the same host, so the
# browser needs no origin at all.
#
# VITE_API_URL=/
#
# Prefer it over naming the site's own URL. An absolute URL has to match the
# host in the address bar exactly, and Vercel gives a project several — the
# short production alias, the long team alias, a per-branch preview. Point the
# app at one while browsing another and every call is cross-origin: the browser
# preflights, Deployment Protection answers with a challenge that carries no
# CORS headers, and the app can only report "Failed to fetch" because no
# response was ever delivered.
#
# A genuinely separate API host takes the full origin, scheme included:
# VITE_API_URL=https://pmo-api.example.com
#
# Then set ALLOWED_ORIGIN below to the site's origin, because CORS now applies.


# ---- the server ----------------------------------------------------------

# PostgreSQL connection string. Required by the API, by db/seed.ts,
# db/seed-users.ts, db/user.ts, and by every backend gate.
# `scripts/local-postgres.sh start` prints one for local work.
DATABASE_URL=postgres://pmo@127.0.0.1:5433/pmo
#
# ON SUPABASE, use the POOLER string, not the direct one. A serverless
# function opens a connection per invocation and direct Postgres runs out
# of them quickly. Supabase → Project Settings → Database → Connection
# string → Transaction pooler (port 6543), and set PGPOOL_MAX=1 below.
# SSL is required, so keep sslmode on the end:
#
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#
# Two things to get right on Supabase, both in docs/GOING_LIVE.md:
#   - deny PostgREST access to these tables (RLS deny-all, or keep the
#     schema out of the exposed list). Reconciliation and separation of
#     duties are enforced in the server and the constraints; a REST route
#     straight to the tables goes around the first of those.
#   - keep the schema in db/migrations/*.sql, not the dashboard.

# Secret used to sign and verify session tokens (HS256). Required in any
# deployment that serves real users — an empty secret means every token is
# forgeable. Use a long random value, and CHANGE IT when the throwaway
# dummy data is replaced, so no token from the dev instance stays valid.
#   openssl rand -base64 48
AUTH_SECRET=change-me-openssl-rand-base64-48

# How long a session token stays valid, in seconds. Default 28800 (8 hours).
# TOKEN_TTL_SECONDS=28800

# Origin allowed to call the API cross-origin. Default '*'. Set it to the
# exact site origin when the API is on a different host from the app.
# ALLOWED_ORIGIN=https://pmo.example.com

# Port for the long-lived server (server/server.ts). Default 4000.
# Not used by the serverless entry point, which is given a port by the host.
# PORT=4000

# Postgres connection pool size. Default 10. Lower it on a serverless host
# with a connection cap — set it to 1 behind a Supabase transaction pooler,
# which is already pooling on the other side.
# PGPOOL_MAX=10

# Set to `test` to stop server/server.ts printing its banner.
# NODE_ENV=development


# ---- the model -----------------------------------------------------------

# Gemini API key. SERVER-SIDE ONLY.
#
#   NEVER name this VITE_GEMINI_API_KEY, or prefix any key with VITE_.
#
# Vite inlines every VITE_* variable into the bundle at build time, so a key
# named that way ends up as a literal string inside dist/index.html — a file
# that is downloaded, emailed around, and served from a public URL. It is a
# leaked key on the first deploy, and rotating it is the only fix.
#
# The browser never calls the model. It calls the API, and the API calls the
# model — the same reason server/xlsx.ts parses the spreadsheet rather than
# the browser doing it. eslint.config.js refuses a model SDK inside src/.
# Setting it turns on BOTH the assistant and document extraction. Leaving it
# unset is a valid deployment: the assistant falls back to the fixed rules
# that compute from the position, and AI Extract says it is not configured
# rather than offering a button that fails.
# GEMINI_API_KEY=

# Which model the API uses. Optional; defaults to gemini-3.5-flash-lite.
# Kept as a variable so a newer model — or a rollback — is a redeploy of the
# same code rather than a change to it.
# GEMINI_MODEL=gemini-3.5-flash-lite

# The API base. Optional, and normally left alone. It exists so the QA gate
# can stand a stub model in front of the routes and prove the whole path
# without a key and without spending a request.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# WHAT THE MODEL MAY DO, AND WHAT IT MAY NOT.
#
# The assistant NEVER does arithmetic. server/ai-brief.ts computes every
# figure from the same position and the same functions the screens read, and
# the model is given that brief and told that every figure it states must
# appear in it. The brief is built from the developments the person asking
# may see, so it is also the access boundary.
#
# Extraction fills a FORM; it never files anything. A model-derived figure
# reaches the position by the same road as a typed one — a person reviews it,
# and the server's twenty reconciliation controls run before the write. A
# field the reader could not make out comes back null rather than guessed.
#
# The forecast in src/domain/forecast.ts stays deterministic. A number nobody
# can reproduce is not a number a controls system can report.


# ---- the gates (local only, never a deployment) --------------------------

# Ports the checks bind. Each has a default and only needs setting if
# something else on the machine already holds it.
#   API_PORT   check:api 4123, check:platform 4125, check:qa 4135,
#              check:workflow 4127
#   WEB_PORT   the static server for check:platform 4126, check:qa 4136
#   STUB_PORT  check:qa's stub model, 4137
# API_PORT=4123
# WEB_PORT=4126
